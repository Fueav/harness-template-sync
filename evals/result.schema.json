{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "eval_contract_version",
    "skill_package_sha256",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "mode",
          "decision",
          "path_decisions",
          "blockers",
          "target_gates",
          "evidence",
          "execution"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "bootstrap",
              "upgrade"
            ]
          },
          "decision": {
            "enum": [
              "continue",
              "blocked"
            ]
          },
          "path_decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "action"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "action": {
                  "enum": [
                    "preserve",
                    "add",
                    "merge",
                    "relocate",
                    "retire",
                    "regenerate",
                    "blocked"
                  ]
                }
              }
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prompt_skill_line_delta": {
            "type": "integer"
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact",
              "sha256"
            ],
            "properties": {
              "artifact": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "eval_contract_version": {
      "const": 3
    }
  }
}
